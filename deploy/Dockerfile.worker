FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @meme/domain build && pnpm --filter @meme/engine build && pnpm --filter @meme/worker build
CMD ["pnpm", "--filter", "@meme/worker", "dev"]
